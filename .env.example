# ==========================================
# LAN AIRDROP ENVIRONMENT CONFIGURATION
# ==========================================

# Signaling Server Port
PORT=3001

# Client Vite Dev Port
CLIENT_PORT=5173

# Signaling Server URL (used by client if not on default window.location.hostname:3001)
VITE_SIGNALING_SERVER_URL=http://localhost:3001

# Optional TURN Server Configuration (Fallback for strict symmetric NATs / venue Wi-Fi isolation)
# Public STUN servers are already enabled by default (stun.l.google.com:19302)
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
